        </mxCell>
        <mxCell id="jobBox" value="JOB · ingest_finance_cockpit_medallion  (triggered / scheduled, not continuous)" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#5c665e;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="60" y="210" width="900" height="1370" as="geometry" />
        </mxCell>
        <mxCell id="task1" value="Task 1 — split_excel_to_csv&#xa;(notebook task)&#xa;pandas + openpyxl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=#A50040;fontSize=12;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="100" y="260" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="csvLanding" value="/Volumes/workspace/default/raw/&#xa;csv_landing/&lt;table&gt;/&#xa;one timestamped CSV per table per run&#xa;+ _snapshot_ts column" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e3c800;strokeColor=#B09500;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="100" y="380" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="task2Box" value="Task 2 — run_medallion_pipeline (pipeline_task)&#xa;triggers ⇒ Lakeflow Declarative Pipeline (serverless, single pipeline)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#6a00ff;strokeColor=#3700CC;spacingTop=6;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="500" y="260" width="400" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="autoloader" value="Auto Loader (cloudFiles)&#xa;incremental file discovery, per table&#xa;only new CSV files are ever read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a0522d;strokeColor=#6D1F00;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="540" y="330" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bronze" value="BRONZE — workspace.dev_finance_cockpit_bronze&#xa;15 @dp.table streaming tables&#xa;append-only: every export snapshot kept, forever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;strokeColor=#432D57;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="540" y="440" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="latestSnapshot" value="&lt;table&gt;_latest_snapshot  (@dp.view, batch)&#xa;filter to newest _snapshot_ts&#xa;Excel-serial date casts&#xa;dropDuplicates(key)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#B20000;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="540" y="560" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="autocdc" value="create_auto_cdc_from_snapshot_flow&#xa;keyed upsert; key missing from snapshot ⇒ delete&#xa;SCD1 × 6 tables · SCD2 × 9 tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;strokeColor=#B09500;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="540" y="690" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="silver" value="SILVER — workspace.dev_finance_cockpit_silver&#xa;15 current-state tables&#xa;SCD2 tables also carry __START_AT / __END_AT history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;strokeColor=#314354;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="540" y="810" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="goldAgg" value="@dp.table  (full recompute, every run)&#xa;joins + aggregations over current silver rows&#xa;( __END_AT IS NULL only — history filtered out )" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#00aba9;strokeColor=#007A78;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="540" y="930" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="goldStar" value="GOLD STAR SCHEMA — workspace.dev_finance_cockpit_gold&#xa;7 dims: department, supplier, cpv, project,&#xa;  contract, procedure, date&#xa;6 facts: invoices, purchase_orders,&#xa;  contract_financials, procurement_bids,&#xa;  procurement_performance, project_financials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#A86F00;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="540" y="1020" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="goldKpi" value="KPI VIEWS  (@dp.materialized_view)&#xa;mv_procurement_savings_kpi&#xa;mv_project_realization_kpi&#xa;denormalized · incrementally maintained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#aa00ff;strokeColor=#7200AA;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="540" y="1160" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qualityTests" value="quality_tests_gold_uniqueness.py&#xa;15 × @dp.expect_or_fail(&quot;unique_key&quot;, &quot;num_entries = 1&quot;)&#xa;pipeline update fails if any gold key duplicates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a20025;strokeColor=#6E0019;fontSize=11;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="540" y="1280" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="powerbi" value="Power BI  —  pbi/unified_finance_cockpit.pbip&#xa;import-mode semantic model on the star schema&#xa;Department → Project → Contract → PO → Invoice drill-down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2C811;strokeColor=#8C6D00;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="540" y="1620" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1 pipeline with 2 task&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Task 1 - splitting excel into csv files by excel sheets to be able to use auto loader&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Task 2 - Medallion architecture elements creation by using databricks pipeline module wrapper functions&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;SCD2 (full history kept)&lt;br&gt;projects · budget_plan · procurement_plan · procurement_procedures&lt;br&gt;procurement_bids · contracts · contract_annexes · purchase_orders · invoices&lt;br&gt;&lt;br&gt;SCD1 (current value only)&lt;br&gt;cpv_lookup · department_lookup · supplier_lookup&lt;br&gt;dashboard_summary · summary_by_year · source_notes&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=10;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;" parent="1" vertex="1">
