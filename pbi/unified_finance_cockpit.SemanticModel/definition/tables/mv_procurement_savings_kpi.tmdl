table mv_procurement_savings_kpi
	lineageTag: c97bb38d-060c-4d7c-aba1-26c9359d47dc

	measure 'Savings %' = SELECTEDVALUE(mv_procurement_savings_kpi[savings_pct])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 65548fc8-f71d-4b30-a4bc-7c090e05f65a

	measure 'Rejected Bid Count' =
			
			CALCULATE(
			    COUNTROWS(fact_procurement_bids),
			    fact_procurement_bids[bid_status] <> "Odabrana"
			)
		formatString: 0
		lineageTag: b8703730-4634-47d5-9733-bba11ebf090f

	measure 'Awarded Bid Amount' =
			
			IF(
			    SELECTEDVALUE(fact_procurement_bids[bid_status]) = "Odabrana",
			    SELECTEDVALUE(fact_procurement_bids[bid_amount]),
			    BLANK()
			)
		lineageTag: 8f347b7a-f9a7-4bb7-b954-b5d5b01baa07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rejected Bid Amount' =
			
			IF(
			    SELECTEDVALUE(fact_procurement_bids[bid_status]) <> "Odabrana",
			    SELECTEDVALUE(fact_procurement_bids[bid_amount]),
			    BLANK()
			)
		lineageTag: 0aaa34f0-f741-49fd-a691-8ee3b844a21f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Estimated Value (Awarded)' = ```
			
			SUMX(
			    FILTER(
			        fact_procurement_bids,
			        fact_procurement_bids[bid_status] = "Odabrana"
			    ),
			    RELATED(fact_procurement_performance[estimated_value])
			)
			
			```
		lineageTag: 092fe5fd-b48f-4bf7-a0e9-8f60be16be4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Procurement Savings (Awarded)' =
			
			SUMX(
			    FILTER(
			        fact_procurement_bids,
			        fact_procurement_bids[bid_status] = "Odabrana"
			    ),
			    RELATED(mv_procurement_savings_kpi[procurement_savings])
			)
		lineageTag: a5fee2f2-3e50-497a-be1e-0f217f4390e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

