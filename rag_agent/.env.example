# Copy to .env (already gitignored at the repo root) and fill in real values.

ANTHROPIC_API_KEY=

# Matches databricks.yml's workspace.host, without the scheme.
DATABRICKS_SERVER_HOSTNAME=dbc-b4d14cbd-4705.cloud.databricks.com

# From the SQL Warehouse's "Connection Details" tab, or `databricks warehouses get <id>`.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse_id>

# Optional: name of a profile in ~/.databrickscfg to reuse `databricks auth login`'s OAuth
# session instead of a token. Omit to use the SDK's default profile resolution.
DATABRICKS_CONFIG_PROFILE=

# Optional PAT fallback - only needed if DATABRICKS_CONFIG_PROFILE / default OAuth resolution
# doesn't work in your environment. If set, this takes priority over OAuth.
# DATABRICKS_TOKEN=
